# Copie para .env (que está no .gitignore) ou cadastre no painel do Render > Environment.
# Nenhum destes valores deve ser versionado.

SPRING_PROFILES_ACTIVE=prod

# Supabase > Project Settings > Database > Connection string (JDBC).
# Use o "Session pooler" (porta 5432). Se usar o "Transaction pooler" (porta 6543),
# acrescente ?prepareThreshold=0 ao final da URL.
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=troque-me

# Segredo que assina os tokens JWT. Mínimo de 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
APP_JWT_SECRET=troque-por-um-valor-aleatorio-de-no-minimo-32-caracteres

# Usuário administrador criado automaticamente no primeiro start (se não existir nenhum usuário).
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Opcional: chave para a automação de WhatsApp (n8n, Evolution API...) lançar pedidos.
# Se vazia, a integração fica desativada.
APP_INTEGRACAO_API_KEY=

# Opcional: app Android publicado na Google Play (TWA).
# Pacote (ex.: br.com.pointdofrango.app) e SHA-256 da chave de assinatura do Play Console.
APP_ANDROID_PACOTE=
APP_ANDROID_SHA256=
